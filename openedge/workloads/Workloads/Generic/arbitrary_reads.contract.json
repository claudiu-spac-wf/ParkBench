  "operations": [
    {
      "op": "arbitrary-read",
      "tables": ["*"],
      "access": "dynamic-query",
      "bounds": {
        "min": 0,
        "max": 10000
      }
    }
  ],
  "readiness": {
    "mode": "none"
  },
  "seedOwnership": {
    "sourceIsImmutable": true,
    "writableState": "not written"
  }
}
