{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parkbench/matrix-expansion.v1",
  "type": "object",
  "required": ["scenario", "dimensions", "repetitions"],
  "properties": {
    "scenario": { "type": "object", "required": ["id", "version"] },
    "dimensions": { "type": "array", "minItems": 1 },
    "repetitions": { "type": "integer", "minimum": 1 },
    "review": {
      "type": "object",
      "required": ["loadedRunCount", "complete"],
      "properties": {
        "loadedRunCount": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}
