{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parkbench.local/contracts/scenario-v1.schema.json",
  "title": "ParkBench Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "target",
    "workload",
    "phases",
    "observers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "scenario.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "assetRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workload": { "type": "string", "minLength": 1 },
        "databaseImage": { "type": "string", "minLength": 1 },
        "pasImage": { "type": "string", "minLength": 1 },
        "observers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restPath", "databaseService", "pasService", "pasReplicas"],
      "properties": {
        "restPath": {
          "type": "string",
          "pattern": "^/"
        },
        "pasProtocol": {
          "enum": ["http", "https"],
          "default": "http"
        },
        "pasPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8810
        },
        "databaseService": {
          "type": "string",
          "minLength": 1
        },
        "pasService": {
          "type": "string",
          "minLength": 1
        },
        "pasReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "healthPath": {
          "type": "string",
          "pattern": "^/"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "default": 60000
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "load"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "load": {
          "$ref": "#/$defs/load"
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmupSeconds", "measurementSeconds", "cooldownSeconds"],
      "properties": {
        "warmupSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "measurementSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "cooldownSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "observers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observer"
      }
    },
    "requiredMeasurements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/requiredMeasurement"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "weight"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "method": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bodyTemplate": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        },
        "expectedStatus": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "minItems": 1
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "concurrency"],
      "properties": {
        "mode": {
          "const": "constant-concurrency"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxInFlightPerWorker": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required", "samplingIntervalSeconds", "metrics"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "kind": {
          "anyOf": [
            { "enum": ["core", "openedge_db_v1", "openedge_pas_v1", "file_sampler_v1"] },
            { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}_v[0-9]+$" }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "samplingIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_:]{1,127}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "configuration": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "requiredMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metricName", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "metricName": {
          "type": "string",
          "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]{1,127}$"
        },
        "source": {
          "enum": ["observer", "workload", "database", "pas"]
        },
        "observerId": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["warmup", "measurement", "cooldown"]
          }
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
