  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Runs",
      "description": "Runs that overlap the selected time range. Click a run to set the time range to its span and show its phase markers. The data is not filtered by run.",
      "datasource": {
        "type": "prometheus",
        "uid": "parkbench-runs"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "parkbench": {
        "panelId": "picker.runs",
        "category": "requests",
        "split": "none",
        "breakdown": "none"
      },
      "type": "table",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No runs in range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this run's time range",
                    "url": "/d/${__dashboard.uid}?var-picker_run=${__data.fields.run_id}&from=${__data.fields.start_ms}&to=${__data.fields.end_ms}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(start_ms|end_ms)$"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "parkbench-runs"
          },
          "expr": "parkbench_run_window{window_start=\"$__from\",window_end=\"$__to\"}",
          "legendFormat": "{{run_id}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Value",
                "destinationType": "number"
              },
              {
                "targetField": "start_ms",
                "destinationType": "number"
              },
              {
                "targetField": "end_ms",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "Started"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Started",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Summary",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "title": "CPU usage",
      "description": "Overall host CPU usage, 0–100% of all cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "parkbench": {
        "panelId": "summary.cpu",
        "category": "cpu_host_pct",
        "split": "none",
        "breakdown": "none"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "insertNulls": false,
            "showPoints": "never",
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Memory usage",
      "description": "Memory in use (total minus available), with total memory as a reference line.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "parkbench": {
        "panelId": "summary.memory",
        "category": "memory",
        "split": "none",
        "breakdown": "none"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "insertNulls": false,
            "showPoints": "never",
            "axisLabel": ""
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Total$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{job=\"node-exporter\"} - node_memory_MemAvailable_bytes{job=\"node-exporter\"}",
          "legendFormat": "Used",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{job=\"node-exporter\"}",
          "legendFormat": "Total",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Disk usage by disk",
      "description": "Read and write throughput per physical disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "parkbench": {
        "panelId": "summary.disk",
        "category": "disk_throughput",
        "split": "read_write",
        "breakdown": "disk"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "No data",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "insertNulls": false,
            "showPoints": "never",
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device) (rate(node_disk_read_bytes_total{job=\"node-exporter\",device!~\"$disk_exclude\"}[$__rate_interval]))",
          "legendFormat": "{{device}} · Read",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device) (rate(node_disk_written_bytes_total{job=\"node-exporter\",device!~\"$disk_exclude\"}[$__rate_interval]))",
          "legendFormat": "{{device}} · Write",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Network usage",
      "description": "Traffic per physical network interface. Loopback, Docker bridges and container interfaces are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "parkbench": {
        "panelId": "summary.network",
        "category": "net_throughput",
        "split": "in_out",
        "breakdown": "interface"
      },
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "No data",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "insertNulls": false,
            "showPoints": "never",
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{job=\"node-exporter\",device!~\"$interface_exclude\"}[$__rate_interval]))",
          "legendFormat": "{{device}} · In",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{job=\"node-exporter\",device!~\"$interface_exclude\"}[$__rate_interval]))",
          "legendFormat": "{{device}} · Out",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "CPU",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 9,
          "title": "CPU usage by core",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 27,
            "w": 12,
            "h": 8
          },
          "parkbench": {
            "panelId": "cpu.per_core",
            "category": "cpu_host_pct",
            "split": "none",
            "breakdown": "core"
          },
          "type": "timeseries",
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "noValue": "No data",
              "min": 0,
              "max": 100,
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 10,
                "spanNulls": false,
                "insertNulls": false,
                "showPoints": "never",
                "axisLabel": ""
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": [
                "mean",
                "max"
              ],
              "sortBy": "Mean",
              "sortDesc": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "100 * (1 - avg by (cpu) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))",
              "legendFormat": "cpu {{cpu}}",
              "range": true,
              "instant": false
            }
          ]
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Memory",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 11,
          "title": "Memory composition",
          "description": "Used, cached/buffers and available memory, plus swap in use.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 36,
            "w": 12,
            "h": 8
          },
          "parkbench": {
            "panelId": "memory.composition",
            "category": "memory",
            "split": "none",
            "breakdown": "none"
          },
          "type": "timeseries",
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "noValue": "No data",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 10,
                "spanNulls": false,
                "insertNulls": false,
                "showPoints": "never",
                "axisLabel": ""
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": [
                "mean",
                "max"
              ],
              "sortBy": "Mean",
              "sortDesc": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "node_memory_MemTotal_bytes{job=\"node-exporter\"} - node_memory_MemAvailable_bytes{job=\"node-exporter\"}",
              "legendFormat": "Used",
              "range": true,
              "instant": false
            },
            {
              "refId": "B",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "node_memory_Cached_bytes{job=\"node-exporter\"} + node_memory_Buffers_bytes{job=\"node-exporter\"}",
              "legendFormat": "Cached/buffers",
              "range": true,
              "instant": false
            },
            {
              "refId": "C",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "node_memory_MemAvailable_bytes{job=\"node-exporter\"}",
