{
  "uid": "parkbench-host-resources",
  "title": "Host Resources",
  "tags": [
    "parkbench",
    "resources",
    "host"
  ],
  "description": "Data for the selected time range. Pick a run in the Runs table to jump to its time range and phase markers; the data is not filtered by run.",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "picker_run",
        "label": "Run shown on the time range",
        "hide": 2,
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      },
      {
        "type": "constant",
        "name": "parkbench_web_url",
        "hide": 2,
        "query": "http://127.0.0.1:13002",
        "current": {
          "text": "http://127.0.0.1:13002",
          "value": "http://127.0.0.1:13002"
        },
        "options": [
          {
            "text": "http://127.0.0.1:13002",
            "value": "http://127.0.0.1:13002",
            "selected": true
          }
        ],
        "skipUrlSync": true
      },
      {
        "type": "constant",
        "name": "disk_exclude",
        "hide": 2,
        "query": "(loop|ram|zram|fd|sr|dm-|md).*",
        "current": {
          "text": "(loop|ram|zram|fd|sr|dm-|md).*",
          "value": "(loop|ram|zram|fd|sr|dm-|md).*"
        },
        "options": [
          {
            "text": "(loop|ram|zram|fd|sr|dm-|md).*",
            "value": "(loop|ram|zram|fd|sr|dm-|md).*",
            "selected": true
          }
        ],
        "skipUrlSync": true
      },
      {
        "type": "constant",
        "name": "interface_exclude",
        "hide": 2,
        "query": "lo|docker.*|br-.*|veth.*|virbr.*|cni.*|flannel.*|cali.*|vxlan.*|tun.*|tap.*|wg.*",
        "current": {
          "text": "lo|docker.*|br-.*|veth.*|virbr.*|cni.*|flannel.*|cali.*|vxlan.*|tun.*|tap.*|wg.*",
          "value": "lo|docker.*|br-.*|veth.*|virbr.*|cni.*|flannel.*|cali.*|vxlan.*|tun.*|tap.*|wg.*"
        },
        "options": [
          {
            "text": "lo|docker.*|br-.*|veth.*|virbr.*|cni.*|flannel.*|cali.*|vxlan.*|tun.*|tap.*|wg.*",
            "value": "lo|docker.*|br-.*|veth.*|virbr.*|cni.*|flannel.*|cali.*|vxlan.*|tun.*|tap.*|wg.*",
            "selected": true
          }
        ],
        "skipUrlSync": true
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Run phases",
        "datasource": {
          "type": "prometheus",
          "uid": "parkbench-runs"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "parkbench_run_phase_boundary{run_id=\"$picker_run\"}",
        "step": "",
        "titleFormat": "{{run_id}}: {{phase}} {{edge}}",
        "textFormat": "",
        "tagKeys": "phase,edge",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
