    "list": [
      {
        "type": "query",
        "name": "run_id",
        "label": "Runs",
        "datasource": {
          "type": "prometheus",
          "uid": "parkbench-runs"
        },
        "definition": "label_values(parkbench_run_window, run_id)",
        "query": {
          "query": "label_values(parkbench_run_window, run_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
