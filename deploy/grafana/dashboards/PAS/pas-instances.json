        "regex": "/message=\"((?:\\\\.|[^\"\\\\])*)\"/",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 0,
        "current": {
          "text": "Notice unavailable; refresh the dashboard.",
