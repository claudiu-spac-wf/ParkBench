        "datasource": {
          "type": "prometheus",
          "uid": "parkbench-runs"
        },
        "query": {
          "query": "label_values(parkbench_run_phase_boundary{run_id=~\"$run_id\"}, phase)",
          "refId": "filter"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "refresh": 1
      },
      {
        "type": "query",
