          "type": "prometheus",
          "uid": "parkbench-runs"
        },
        "query": {
          "query": "label_values(parkbench_openedge_pas_requests_total{run_id=~\"$run_id\"}, replica)",
          "refId": "filter"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "refresh": 1
      },
      {
        "type": "query",
