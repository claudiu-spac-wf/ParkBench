{
  "uid": "parkbench-pas-instances",
  "title": "PAS Instances",
  "tags": [
    "parkbench",
    "pas"
  ],
  "description": "One run: real clock time (UTC). Several runs: runs are aligned on elapsed time since measurement start, which reads 00:00:00 on the axis; times before it are warmup.",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
