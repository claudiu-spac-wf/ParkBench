  "common": {
    "target": {
      "restPath": "/work",
      "pasProtocol": "http",
      "pasPort": 8810,
      "healthPath": "/health",
      "databaseService": "database",
      "pasService": "pas",
      "pasReplicas": 1,
      "timeoutMs": 60000
    },
    "load": {
      "mode": "constant-concurrency",
      "concurrency": 10,
      "maxInFlightPerWorker": 1,
      "seed": 2026
    },
    "observers": [
      {
        "id": "core",
        "kind": "core",
        "required": true,
        "samplingIntervalSeconds": 5,
        "configuration": {
          "metricsUrl": "http://loadgen:9100"
        }
      },
      {
        "id": "openedge-db",
        "kind": "openedge_db_v1",
        "required": true,
        "samplingIntervalSeconds": 5,
        "configuration": {
          "metricsUrl": "http://db-observer:9100"
        }
      },
      {
        "id": "openedge-pas",
        "kind": "openedge_pas_v1",
        "required": true,
        "samplingIntervalSeconds": 5,
