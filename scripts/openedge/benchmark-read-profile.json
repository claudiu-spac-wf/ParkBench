      "id": "reference-currencies",
      "method": "POST",
      "path": "/work",
      "weight": 8,
      "bodyTemplate": {
        "procName": "Workloads/Generic/arbitrary_reads.p",
        "input": {
          "mode": "run",
          "TableName": "Currency",
          "WhereClause": "RandomInt1000 <= {{cutoff}} AND RandomInt1000 = {{band}}",
          "Limit": 0
        }
      },
      "expectedStatus": [
        200
      ],
      "templateValues": {
        "band": {
          "kind": "uniformInt",
          "min": 1,
          "max": 1000
        }
      }
    },
