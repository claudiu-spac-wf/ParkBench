{
  "schemaVersion": "scenario.v2",
  "version": "1.0.0",
  "target": {
    "restPath": "/work",
    "pasProtocol": "http",
    "pasPort": 8810,
    "healthPath": "/health",
    "databaseService": "database",
    "pasService": "pas",
    "pasReplicas": 1,
    "timeoutMs": 60000
