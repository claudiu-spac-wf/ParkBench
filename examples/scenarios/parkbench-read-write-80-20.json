    {
      "id": "core",
      "kind": "core",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://loadgen:9100"
      }
    },
    {
      "id": "openedge-db",
      "kind": "openedge_db_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
