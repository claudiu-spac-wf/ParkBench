        "weight": 1600,
        "bodyTemplate": {
          "procName": "Workloads/Generic/arbitrary_reads.p",
          "input": {
            "mode": "run",
            "TableName": "Currency",
            "WhereClause": "RandomInt1000 <= 870 AND RandomInt1000 = {{band}}",
            "Limit": 0
          }
        },
        "expectedStatus": [
          200
        ],
        "templateValues": {
          "band": {
            "kind": "uniformInt",
            "min": 1,
            "max": 870
          }
        }
