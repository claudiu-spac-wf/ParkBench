{
  "schemaVersion": "scenario.v2",
  "version": "1.0.0",
  "target": {
    "restPath": "/work",
    "pasProtocol": "http",
    "pasPort": 8810,
    "healthPath": "/health",
    "databaseService": "database",
    "pasService": "pas",
    "pasReplicas": 1,
    "timeoutMs": 60000
  },
  "phases": {
    "warmupSeconds": 60,
    "measurementSeconds": 180,
    "cooldownSeconds": 30
  },
  "observers": [
    {
      "id": "core",
      "kind": "core",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://loadgen:9100"
      }
    },
    {
      "id": "openedge-db",
      "kind": "openedge_db_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://db-observer:9100"
      }
    },
    {
      "id": "openedge-pas",
      "kind": "openedge_pas_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://pas-observer:9100"
      }
    },
    {
      "id": "files",
      "kind": "file_sampler_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://file-sampler:9100",
        "path": "/psc/wrk/parkbench"
      }
    }
  ],
  "id": "parkbench-read-mix",
  "name": "ParkBench reads",
  "description": "Complete sampled read buckets within the calibrated eligible data footprint.",
  "workload": {
    "operations": [
      {
        "id": "reference-currencies",
        "method": "POST",
        "path": "/work",
        "weight": 24,
        "bodyTemplate": {
          "procName": "Workloads/Generic/arbitrary_reads.p",
          "input": {
            "mode": "run",
            "TableName": "Currency",
            "WhereClause": "RandomInt100 <= 100 AND RandomInt100 = {{band}}",
            "Limit": 0
          }
        },
        "expectedStatus": [
          200
        ],
        "templateValues": {
          "band": {
            "kind": "uniformInt",
            "min": 1,
            "max": 75
          }
        }
      },
      {
