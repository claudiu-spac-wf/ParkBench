{
  "schemaVersion": "scenario.v2",
  "id": "parkbench-bank-mix",
  "version": "1.0.0",
  "name": "ParkBench banking read/write smoke mix",
  "description": "Point, selective and range reads plus a self-cleaning audit write cycle against a ParkBenchDB seed.",
  "target": {
    "restPath": "/work",
    "pasProtocol": "http",
    "pasPort": 8810,
    "healthPath": "/health",
    "databaseService": "database",
    "pasService": "pas",
    "pasReplicas": 1,
    "timeoutMs": 60000
  },
  "workload": {
    "operations": [
      {
        "id": "reference-point",
        "method": "POST",
        "path": "/work",
        "weight": 4,
        "bodyTemplate": {
          "procName": "Workloads/ParkBench/bank_mix.p",
          "input": {
            "mode": "run",
            "op": "reference-point",
            "key": "generated"
          }
        },
        "expectedStatus": [200]
      },
      {
        "id": "selective",
        "method": "POST",
        "path": "/work",
        "weight": 3,
        "bodyTemplate": {
          "procName": "Workloads/ParkBench/bank_mix.p",
          "input": {
            "mode": "run",
            "op": "selective",
            "key": "generated"
          }
        },
        "expectedStatus": [200]
      },
      {
        "id": "range",
        "method": "POST",
        "path": "/work",
        "weight": 2,
        "bodyTemplate": {
          "procName": "Workloads/ParkBench/bank_mix.p",
          "input": {
            "mode": "run",
            "op": "range",
            "key": "generated"
          }
        },
        "expectedStatus": [200]
      },
      {
        "id": "audit-write-cycle",
        "method": "POST",
        "path": "/work",
        "weight": 1,
        "bodyTemplate": {
          "procName": "Workloads/ParkBench/bank_mix.p",
          "input": {
            "mode": "run",
            "op": "audit-write-cycle",
            "key": "generated"
          }
        },
        "expectedStatus": [200]
      }
    ],
    "load": {
      "mode": "constant-concurrency",
      "concurrency": 2,
      "maxInFlightPerWorker": 1,
      "seed": 2026
    }
  },
  "phases": {
    "warmupSeconds": 60,
    "measurementSeconds": 300,
    "cooldownSeconds": 30
  },
  "observers": [
    {
      "id": "core",
      "kind": "core",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://loadgen:9100"
      }
    },
    {
      "id": "openedge-db",
      "kind": "openedge_db_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://db-observer:9100"
      }
    },
    {
      "id": "openedge-pas",
      "kind": "openedge_pas_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://pas-observer:9100"
      }
    },
    {
      "id": "files",
      "kind": "file_sampler_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://file-sampler:9100",
        "path": "/psc/wrk/parkbench"
      }
    }
  ]
}
