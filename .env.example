# 1. Core application and local host bindings
# These settings control the local control-plane address and published service ports.
PARKBENCH_HOST=127.0.0.1
PARKBENCH_PORT=3000
PARKBENCH_BIND_ADDRESS=127.0.0.1
PARKBENCH_CONTROL_PLANE_HOST_PORT=13000
PARKBENCH_GRAFANA_HOST_PORT=13001
# Local Grafana admin credentials.
PARKBENCH_GRAFANA_ADMIN_USER=admin
PARKBENCH_GRAFANA_ADMIN_PASSWORD=admin
PARKBENCH_WEB_HOST_PORT=13002
PARKBENCH_PROMETHEUS_HOST_PORT=19090
PARKBENCH_CADVISOR_HOST_PORT=18080
# Host socket mounted into the control plane for Docker API access. Relative paths use the repository root.
PARKBENCH_DOCKER_SOCKET_PATH=/var/run/docker.sock

# Optional CPU affinity. Use Docker CPU IDs/lists/ranges, not a count; configured groups must not overlap.
# Leave empty to let Docker schedule freely. Example groups: platform=0-3, PAS=4-5, DB=6,7.
# Pin unrelated containers to other IDs too; these settings constrain ParkBench containers but do not reserve CPUs globally.
PARKBENCH_PLATFORM_CPUSET=
PARKBENCH_PAS_CPUSET=
PARKBENCH_DB_CPUSET=
# Hard DB container RAM cap, including its filesystem cache; no additional swap.
# 10 GiB leaves 2 GiB above the intended 8 GiB combined -B/-B2 cache. Run benchmarks sequentially.
PARKBENCH_DB_MEMORY_LIMIT=10g

# 2. Persistent storage, artifact, and host path mappings
# Relative host paths use the repository root. Direct-host mode uses DB/artifact/run paths below;
# Compose derives fixed paths under /var/lib/parkbench from PARKBENCH_HOST_DATA_ROOT.
# PARKBENCH_DOCKER_HOST_PATH_ROOT may be left blank to use the effective host data root.
PARKBENCH_DB_PATH=./.parkbench/parkbench.sqlite
PARKBENCH_ARTIFACT_ROOT=./.parkbench/artifacts
PARKBENCH_HOST_DATA_ROOT=./.parkbench
PARKBENCH_DOCKER_HOST_PATH_ROOT=
PARKBENCH_RUN_ROOT=./.parkbench/runs

# 3. Observability endpoints, retention, targets, and network
# These settings connect ParkBench to Prometheus/Grafana and control metric retention and discovery.
# PARKBENCH_PROMETHEUS_TARGET_DIR is a host path in direct-host mode and the Compose bind source;
# Compose services use the fixed container target /etc/prometheus/targets.
PARKBENCH_PROMETHEUS_URL=http://127.0.0.1:19090
PARKBENCH_GRAFANA_URL=http://127.0.0.1:13001
PARKBENCH_CADVISOR_URL=http://127.0.0.1:18080
PARKBENCH_PROMETHEUS_SCRAPE_INTERVAL=5s
# cAdvisor adds up to 100% collection jitter. Keep this <= one quarter of the scrape interval.
PARKBENCH_CADVISOR_HOUSEKEEPING_INTERVAL=1s
PARKBENCH_PROMETHEUS_RETENTION=7d
PARKBENCH_PROMETHEUS_TARGET_DIR=.parkbench/prometheus-targets
PARKBENCH_PROMETHEUS_DATA_ROOT=.parkbench/prometheus_data
PARKBENCH_METRICS_NETWORK=parkbench-platform

# 4. Built-in platform runtime and build image references
# These images run ParkBench itself and must use explicit non-latest tags; ParkBench does not compare image digests.
# PARKBENCH_IMAGE_TAG is applied to every image built by ParkBench.
PARKBENCH_IMAGE_TAG=local
PARKBENCH_PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
PARKBENCH_GRAFANA_IMAGE=grafana/grafana:12.1.1
PARKBENCH_CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.55.1
PARKBENCH_NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.9.1
PARKBENCH_NODE_BASE_IMAGE=node:24-bookworm-slim
PARKBENCH_NGINX_IMAGE=nginx:1.29.1-alpine

# 5. Catalog discovery roots
# These settings tell the catalog where to find scenarios, workloads, observers, seeds, archives, and configs.
PARKBENCH_DISCOVERY_SCENARIOS_ROOT=examples/scenarios
PARKBENCH_DISCOVERY_WORKLOADS_ROOT=openedge/workloads/Workloads
PARKBENCH_DISCOVERY_OBSERVERS_ROOT=.parkbench/observers
PARKBENCH_DISCOVERY_SEEDS_ROOT=.parkbench/seeds
PARKBENCH_DISCOVERY_ARCHIVES_ROOT=.parkbench/archives

# 6. Benchmark load-generator and observer image references
# These images execute workload traffic and collect benchmark observations; use explicit non-latest tags.
PARKBENCH_LOADGEN_IMAGE=parkbench/loadgen:local
PARKBENCH_OBSERVER_IMAGE=parkbench/observer:local

# 7. OpenEdge private inputs, credentials, and observer settings
# These settings point to operator-supplied licensed/private inputs and read-only observer configuration.
# Seed used by benchmark runs: a folder under PARKBENCH_DISCOVERY_SEEDS_ROOT that
# holds one Linux OpenEdge database (<db>.db, <db>.st with relative extent paths, and its extents).
PARKBENCH_OPENEDGE_DEFAULT_SEED=
# Optional: reference seed name for compilation provenance; no seed data is copied.
PARKBENCH_OPENEDGE_COMPILE_SEED=
# Matching schema definitions loaded into a small empty compiler database.
PARKBENCH_OPENEDGE_COMPILE_SCHEMA=
PARKBENCH_OPENEDGE_APP_ARCHIVE=
PARKBENCH_OPENEDGE_CREDENTIAL_REF=
PARKBENCH_OPENEDGE_DB_OBSERVER_EXECUTABLE=
PARKBENCH_OPENEDGE_DB_OBSERVER_PROCEDURE=
PARKBENCH_OPENEDGE_DB_OBSERVER_RUNTIME_PATH=
PARKBENCH_OPENEDGE_DB_OBSERVER_ARGS=

# 8. OpenEdge build, compiler, JDK, and output settings
# These settings control licensed image construction, compilation, staging, and generated output locations.
PARKBENCH_OPENEDGE_PROGRESS_ROOT=../IMAGES
PARKBENCH_OPENEDGE_LICENSE_PATH=../progress.cfg
PARKBENCH_OPENEDGE_DB_BASE_IMAGE=progresssoftware/prgs-oedb:12.8.11_ent
PARKBENCH_OPENEDGE_PAS_BASE_IMAGE=progresssoftware/prgs-pasoe:12.8.11
PARKBENCH_OPENEDGE_JDK_IMAGE=
PARKBENCH_OPENEDGE_JDK_PATH=/usr/lib/jvm
PARKBENCH_OPENEDGE_COMPILER=
PARKBENCH_OPENEDGE_OUTPUT_ROOT=.parkbench/openedge
PARKBENCH_OPENEDGE_WORKLOAD_ROOT=openedge/workloads/Workloads

# 9. OpenEdge database, PAS, port, and generated-manifest defaults
# These settings define the OpenEdge services, fixed ports, and optional generated image manifest.
PARKBENCH_OPENEDGE_DB_IMAGE=parkbench/openedge-db:local
PARKBENCH_OPENEDGE_VERSION=12.8.11
# Declare enterprise only after verifying APW/BIW support in the selected licensed DB.
# Example: PARKBENCH_OPENEDGE_DB_FEATURES=enterprise. Recreate the control plane after changes.
PARKBENCH_OPENEDGE_DB_FEATURES=
PARKBENCH_OPENEDGE_PAS_IMAGE=parkbench/openedge-pasoe:local
PARKBENCH_OPENEDGE_OBSERVER_IMAGE=
PARKBENCH_OPENEDGE_DATABASE_NAME=parkbench
PARKBENCH_OPENEDGE_DB_BROKER_PORT=20931
PARKBENCH_OPENEDGE_DB_MINPORT=20932
PARKBENCH_OPENEDGE_DB_MAXPORT=20941
PARKBENCH_OPENEDGE_PAS_INSTANCE=oepas1
PARKBENCH_OPENEDGE_PAS_PORT=8810
PARKBENCH_OPENEDGE_IMAGE_MANIFEST=
