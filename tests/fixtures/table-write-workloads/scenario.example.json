{
  "schemaVersion": "scenario.v2",
  "target": {
    "restPath": "/work",
    "pasProtocol": "http",
    "pasPort": 8810,
    "healthPath": "/health",
    "databaseService": "database",
    "pasService": "pas",
    "pasReplicas": 1,
    "timeoutMs": 60000
  },
  "phases": {
    "warmupSeconds": 30,
    "measurementSeconds": 300,
    "cooldownSeconds": 30
  },
  "observers": [
    {
      "id": "core",
      "kind": "core",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://loadgen:9100"
      }
    },
    {
      "id": "openedge-db",
      "kind": "openedge_db_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://db-observer:9100"
      }
    },
    {
      "id": "openedge-pas",
      "kind": "openedge_pas_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://pas-observer:9100"
      }
    },
    {
      "id": "files",
      "kind": "file_sampler_v1",
      "required": true,
      "samplingIntervalSeconds": 5,
      "configuration": {
        "metricsUrl": "http://file-sampler:9100",
        "path": "/psc/wrk/parkbench"
      }
    }
  ],
